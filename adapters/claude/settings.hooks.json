{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/.outrigger/engine/hook.py\" claude session-start", "timeout": 15 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/.outrigger/engine/hook.py\" claude pre-tool", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|WebFetch|WebSearch|Bash|PowerShell|Grep|mcp__.*",
        "hooks": [
          { "type": "command", "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/.outrigger/engine/hook.py\" claude post-tool", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/.outrigger/engine/hook.py\" claude stop", "timeout": 15 }
        ]
      }
    ]
  }
}
